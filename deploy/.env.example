# Optional settings: copy to .env and uncomment what you need. Nothing here is required.

# The Moodle site. Without it the first sign-in asks for the address and keeps it.
# MOODLE_URL=https://moodle.example.edu

# Local time in the comments for students.
# TZ=Europe/Moscow

# Behind an HTTPS proxy: send the session cookie over HTTPS only.
# COOKIE_SECURE=1

# The port of the web UI on 127.0.0.1.
# APP_PORT=8180

# The user the app runs as and who owns deploy/secrets.
# APP_UID=1000
# APP_GID=1000

# An NVIDIA GPU for the models (needs nvidia-container-toolkit).
# COMPOSE_FILE=docker-compose.yml:compose.gpu.yml

# Fit a larger model context into the video memory: Ollama's own settings.
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q4_0

# No AI check at all: the similarity check and manual grading still work.
# LLM_PROVIDER=none
