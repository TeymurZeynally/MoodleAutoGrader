{
  "name": "moodle-autograder",
  "image": "mcr.microsoft.com/devcontainers/go:1.27",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },
  "customizations": {
    "vscode": { "extensions": ["golang.go", "dbaeumer.vscode-eslint"], "settings": { "go.lintTool": "golangci-lint-v2", "eslint.workingDirectories": ["src/web"] } }
  },
  "postCreateCommand": "go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0"
}
